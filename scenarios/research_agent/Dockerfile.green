# Dockerfile for Research Evaluator (Green Agent)
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install UV package manager
RUN pip install uv

# Copy requirements
COPY pyproject.toml .
COPY uv.lock .

# Install dependencies
RUN uv sync --frozen

# Copy application code
COPY research_evaluator.py .
COPY server.py .

# Set the entrypoint
ENTRYPOINT ["uv", "run", "python", "server.py"]