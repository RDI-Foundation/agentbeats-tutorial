# Dockerfile for Research Evaluator (Green Agent)
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install UV package manager
RUN pip install uv

# Copy requirements
COPY scenarios/research_agent/pyproject.toml .
COPY scenarios/research_agent/uv.lock .

# Install dependencies
RUN uv sync --frozen

# Copy application code
COPY scenarios/research_agent/research_evaluator.py .
COPY scenarios/research_agent/server.py .

# Set the entrypoint
ENTRYPOINT ["uv", "run", "python", "server.py"]