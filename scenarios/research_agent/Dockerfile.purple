# Dockerfile for Research Agent (Purple Agent)
FROM python:3.11-slim

WORKDIR /app

RUN pip install uv

COPY scenarios/research_agent/pyproject.toml .
COPY scenarios/research_agent/uv.lock .

RUN uv sync --frozen

COPY scenarios/research_agent/research_agent.py .
COPY scenarios/research_agent/purple_server.py .

ENTRYPOINT ["uv", "run", "python", "purple_server.py"]